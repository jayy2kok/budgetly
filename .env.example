# Budgetly API — environment variables for docker-compose.
# Copy this file to `.env` (which is git-ignored) and fill in real values:
#
#   cp .env.example .env
#

# ── Google OAuth (REQUIRED) ──────────────────────────────────────────────────
# Web client ID from https://console.cloud.google.com/apis/credentials
# Format: <digits>-<hash>.apps.googleusercontent.com
# Used as the audience when verifying Google ID tokens. Without it, every
# "Continue with Google" sign-in fails and the API refuses to start.
GOOGLE_CLIENT_ID=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Signing secret for app JWTs. Override in any non-local deployment.
JWT_SECRET=budgetly-super-secret-key-for-development-min-256-bits-long

# ── LLM provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://rpi.local:20129/v1
OPENAI_API_KEY=
OPENAI_MODEL=auto/best-free

# ── MongoDB (optional overrides) ─────────────────────────────────────────────
# MONGO_HOST_PORT=27018